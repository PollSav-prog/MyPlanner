<Window x:Class="MyPlanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:MyPlanner.Services"
        Title="{svc:T app_title}"
        MinWidth="920" MinHeight="600" Width="1100" Height="720"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource FgPrimary}"
        FontSize="14"
        Closing="Window_Closing" StateChanged="Window_StateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ============ КАЛЕНДАРЬ ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource NavButton}" Content="&#xE892;" Command="{Binding PrevYearCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource NavButton}" Content="&#xE76B;" Command="{Binding PrevMonthCommand}" />
                        <TextBlock Grid.Column="2" Text="{Binding MonthTitle}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource NavButton}" Content="&#xE76C;" Command="{Binding NextMonthCommand}" />
                        <Button Grid.Column="4" Style="{StaticResource NavButton}" Content="&#xE893;" Command="{Binding NextYearCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WeekDays}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource FgSecondary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="cell" Height="44" Margin="1" CornerRadius="10" Background="Transparent"
                                        Cursor="Hand" MouseLeftButtonUp="Cell_Click">
                                    <Grid>
                                        <!-- красный круг вокруг выбранной даты -->
                                        <Ellipse x:Name="ring" Width="34" Height="34" StrokeThickness="2.2"
                                                 Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <TextBlock x:Name="num" Text="{Binding Text}" Opacity="{Binding TextOpacity}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <!-- отметка: на дате есть задачи -->
                                        <Ellipse x:Name="dot" Width="5" Height="5" VerticalAlignment="Bottom"
                                                 Margin="0,0,0,3" Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed" />
                                        <!-- объёмная капелька-предупреждение -->
                                        <Button x:Name="drop" Click="Droplet_Click" Cursor="Hand" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="16" Height="22" Margin="0,-2,0,0" Padding="0"
                                                ToolTip="{svc:T tip_droplet}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Path Data="{StaticResource DropletGeometry}" Stretch="Uniform"
                                                              Stroke="#A8322F" StrokeThickness="0.6">
                                                            <Path.Fill>
                                                                <RadialGradientBrush GradientOrigin="0.35,0.65" Center="0.5,0.62" RadiusX="0.75" RadiusY="0.75">
                                                                    <GradientStop Color="#FF9A9A" Offset="0" />
                                                                    <GradientStop Color="#E53935" Offset="0.55" />
                                                                    <GradientStop Color="#9E1F1C" Offset="1" />
                                                                </RadialGradientBrush>
                                                            </Path.Fill>
                                                            <Path.Effect>
                                                                <DropShadowEffect Color="#E53935" BlurRadius="6" ShadowDepth="0" Opacity="0.55" />
                                                            </Path.Effect>
                                                        </Path>
                                                        <Ellipse Width="4" Height="6" Fill="#CCFFFFFF" HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center" Margin="3,5,0,0" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock x:Name="dropCount" Text="{Binding DropletCount}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,6,4.5,0" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="num" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="num" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasTasks}" Value="True">
                                        <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDroplet}" Value="True">
                                        <Setter TargetName="drop" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowDropletCount}" Value="True">
                                        <Setter TargetName="dropCount" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cell" Property="Background" Value="{DynamicResource CardHoverBg}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{svc:T btn_today}" Command="{Binding TodayCommand}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Padding="10,7" />
                </StackPanel>
            </Border>

            <!-- ============ МОИ ПЛАНЫ ============ -->
            <Grid Grid.Column="1" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,12">
                    <TextBlock Text="{svc:T plans_title}" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedDateText}" Style="{StaticResource Muted}" FontSize="15" Margin="0,2,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TaskRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="TaskList_DoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{svc:T tip_edit}" Command="{Binding EditCommand}" />
                                <MenuItem Header="{svc:T tip_done}" Command="{Binding DoneCommand}" />
                                <Separator />
                                <MenuItem Header="{svc:T move_today}" Command="{Binding MoveCommand}" CommandParameter="today" />
                                <MenuItem Header="{svc:T move_tomorrow}" Command="{Binding MoveCommand}" CommandParameter="tomorrow" />
                                <MenuItem Header="{svc:T move_week}" Command="{Binding MoveCommand}" CommandParameter="week" />
                                <Separator />
                                <MenuItem Header="{svc:T btn_delete}" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding RowOpacity}" MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding PriorityBrush}" CornerRadius="12,0,0,12" />
                                    <Button Grid.Column="1" Width="30" Height="30" Margin="12,0,6,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Padding="0" ToolTip="{svc:T tip_done}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse Stroke="{DynamicResource FgSecondary}" StrokeThickness="2" />
                                                    <TextBlock Text="{Binding DoneMark}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrioLow}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Grid.Column="2" Margin="6,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   TextDecorations="{Binding Decor}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                            <TextBlock.Visibility>
                                                <Binding Path="HasDescription">
                                                    <Binding.Converter>
                                                        <BooleanToVisibilityConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Style="{StaticResource Muted}" Margin="0,0,10,0">
                                                <TextBlock.Visibility>
                                                    <Binding Path="HasCategory">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="11" Style="{StaticResource Muted}" Margin="0,1,4,0">
                                                <TextBlock.Visibility>
                                                    <Binding Path="IsRepeating">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBlock Text="{Binding RepeatText}" FontSize="11" Style="{StaticResource Muted}">
                                                <TextBlock.Visibility>
                                                    <Binding Path="IsRepeating">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{svc:T status_overdue}" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                   HorizontalAlignment="Right" Visibility="{Binding OverdueVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{svc:T no_tasks}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=TaskList}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,2,8,0" />
                            <TextBlock Text="{svc:T btn_add_task}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding VoiceCommand}"
                            ToolTip="{svc:T tip_voice}" Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,2,8,0" />
                            <TextBlock Text="{svc:T btn_voice}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ ПРАВАЯ ПАНЕЛЬ: 9 ФУНКЦИЙ ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,8" VerticalAlignment="Top">
                <StackPanel>
                    <Button Style="{StaticResource SideButton}" Content="&#xE710;" Command="{Binding AddCommand}" ToolTip="{svc:T tip_add}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE70F;" Command="{Binding EditCommand}" ToolTip="{svc:T tip_edit}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE930;" Command="{Binding DoneCommand}" ToolTip="{svc:T tip_done}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE895;" Command="{Binding RepeatCommand}" ToolTip="{svc:T tip_repeat}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE767;" Command="{Binding SoundCommand}" ToolTip="{svc:T tip_sound}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE708;" Command="{Binding QuietCommand}" ToolTip="{svc:T tip_quiet}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE753;" Command="{Binding WeatherCommand}" ToolTip="{svc:T tip_weather}" />
                    <Button Style="{StaticResource SideButton}" Content="&#xE81C;" Command="{Binding HistoryCommand}" ToolTip="{svc:T tip_history}" />
                    <Button x:Name="LangButton" Style="{StaticResource SideButton}" Content="&#xE774;" Click="LangButton_Click" ToolTip="{svc:T tip_language}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ НИЖНЯЯ ПАНЕЛЬ: ЧАСЫ И ПОГОДА ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,16" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ClockText}" FontSize="32" FontWeight="Light"
                           VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateLine}" FontSize="15" />
                    <TextBlock Text="{Binding QuietText}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding WeatherIcon}" FontFamily="Segoe UI Emoji" FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WeatherTemp}" FontSize="20" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding WeatherCity}" FontSize="15" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding WeatherInfo}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource NavButton}" Content="&#xE713;" FontSize="16" Width="38" Height="38"
                        Command="{Binding SettingsCommand}" ToolTip="{svc:T tip_settings}" />
            </Grid>
        </Border>
    </Grid>
</Window>
